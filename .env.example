POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=digital_card
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/digital_card?schema=public
PORT=3000

# Trusted reverse proxy hops/IPs for accurate client rate limiting (req.ip).
# - "1" (recommended): trusts the immediate reverse proxy (Nginx).
# - "loopback, uniquelocal": trusts localhost and private Docker subnets.
# - Leave empty only if the application container is exposed directly without any reverse proxy.
TRUSTED_PROXIES=1