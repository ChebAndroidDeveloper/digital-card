generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String       @id @default(uuid())
  locale      String       @default("en") // "en" или "ru"
  name        String
  title       String
  description String
  location    String?
  phone       String?
  telegram    String?
  githubUrl   String?
  linkedinUrl String?
  email       String?
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
  education   Education[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([locale])
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  category  String?
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  key       String

  @@unique([profileId, key])
}

model Experience {
  id           String   @id @default(uuid())
  company      String
  position     String
  period       String
  achievements String[]
  sortOrder    Int      @default(0)
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  key          String

  @@unique([profileId, key])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  url         String?
  sortOrder   Int      @default(0)
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  key         String

  @@unique([profileId, key])
}

model Education {
  id          String   @id @default(uuid())
  institution String
  year        String
  faculty     String
  sortOrder   Int      @default(0)
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  key         String

  @@unique([profileId, key])
}
